# Copy this file to .env.local and fill it in. Never commit .env.local.

# MongoDB: documentations, pages, drafts, activity log, feedback, site settings.
# The database name is the part after the last "/" (for example .../ai-docbuilder?...).
MONGODB_URI=

# Cloudinary: screenshots and other images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=aidocbuilder-docs

# Public address of the site, used for the sitemap, robots.txt and link previews.
# Optional on Vercel, which supplies its own address. Set it when you use a custom
# domain, for example SITE_URL=https://docs.aidocbuilder.com
SITE_URL=http://localhost:3000

# Editor panel (/admin). Everyone signs in with their own account.
SESSION_SECRET=            # signs the session cookie: openssl rand -hex 32
# The first account. It is created (as a reviewer) the first time someone signs
# in with this email and password while there are no users yet. Add more people
# under "Users" in the editor. At least 10 characters.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
